# VeriTax Protocol Layer — OKX Edition
# Copy this file to .env and fill in your credentials.

# OKX API Credentials (V5)
OKX_API_KEY=your_okx_api_key_here
OKX_SECRET_KEY=your_okx_secret_key_here
OKX_PASSPHRASE=your_okx_passphrase_here
OKX_SANDBOX=false

# Reclaim Protocol (zkTLS)
RECLAIM_APP_ID=your_reclaim_app_id
RECLAIM_APP_SECRET=your_reclaim_app_secret

# Pinata (IPFS)
PINATA_JWT=your_pinata_jwt_token
PINATA_GATEWAY=your_pinata_gateway_url

# Phala Network (TEE)
PHALA_API_TOKEN=your_phala_api_token
VERITAX_TEE_ENDPOINT=
VERITAX_TEE_AUTH_TOKEN=

# OpenClaw
OPENCLAW_PORT=18789

# OKX OnChainOS
CHAIN_NAME=xlayer
CHAIN_INDEX=196
VERITAX_ONCHAIN_RPC_URL=https://rpc.xlayer.tech
VERITAX_ONCHAIN_WALLET_ADDRESS=
VERITAX_ONCHAIN_PRIVATE_KEY=
